# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT VARIABLES (S-I-I-P)
# Salin file ini menjadi .env lalu isi dengan kredensial asli Anda.
# ==============================================================================

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=foto_absen

# Google Apps Script Web App
GAS_API_URL=https://script.google.com/macros/s/your-gas-id/exec

PORT=3000
NODE_ENV=development
